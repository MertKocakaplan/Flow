# Build outputs in the package folder (source\Flow.exe.config stays tracked)
/*.exe
/*.exe.config
# Bundled third-party binaries; only the manifest is tracked
/tools/*
!/tools/components.json
# Test output, review artifacts, local tool workspaces
/.test/
/.review-*/
/.argon-review/
/.superpowers/
# Sentient (Fontshare, ITF FFL): embedding in the app is allowed, redistributing the file is not
/source/fonts/
/chrome-extension/fonts/
/opera-extension/fonts/

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow" Width="1180" Height="840" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.TaskbarItemInfo><TaskbarItemInfo x:Name="Taskbar"/></Window.TaskbarItemInfo>
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Afiş ızgarası: Bahnschrift carries headings, labels, buttons and every number; long text stays in Segoe UI. -->
    <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <!-- Buttons: square, 1 px ink frame; the primary button is the screen's one reversed plate. -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Border x:Name="Hover" Background="{DynamicResource Text}" Opacity="0"/>
          <Border x:Name="Ring" Margin="-3" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Visibility="Collapsed"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <!-- Motion: a 120 ms overlay on hover and press; buttons with centred content also give way to 0.96.
               Wide buttons (HorizontalContentAlignment=Stretch) keep still. Zero with Windows animations off. -->
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.13" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="HorizontalContentAlignment" Value="Center"/></MultiTrigger.Conditions>
            <MultiTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="{StaticResource MotionFast}"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
            <MultiTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource MotionFast}"/><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
          </MultiTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Rail navigation: white type on the cobalt field; the current page is a darker plate. -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid>
          <Border x:Name="Hover" Background="{DynamicResource SidebarHover}" Opacity="0"/>
          <Border x:Name="Bg" Background="Transparent"/>
          <Border x:Name="Ring" Margin="1" BorderBrush="{DynamicResource SidebarText}" BorderThickness="2" Visibility="Collapsed"/>
          <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarActive}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="22"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="NavText" TargetType="TextBlock"><Setter Property="Margin" Value="12,0,0,1"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>

    <!-- Platform tabs: plain words on a hairline; the chosen one stands on a 2 px ink rule. -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="GroupName" Value="platform"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <Border x:Name="Rule" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource BorderStrong}" Visibility="Hidden"/>
          <Border x:Name="Ring" Margin="0,2" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Visibility="Collapsed"/>
          <ContentPresenter Margin="8,0,8,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Rule" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Inputs: square fields with a 1 px frame; focus is a 2 px cobalt frame. -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionOpacity" Value="0.3"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Border x:Name="Ring" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Visibility="Collapsed"/>
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
          <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextFaint}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Surface2}"/><Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="MaxDropDownHeight" Value="360"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Box" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1">
                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{DynamicResource Text}" StrokeThickness="1.4"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ContentPresenter.Resources></ContentPresenter>
          <Border x:Name="Ring" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Padding="0,4">
              <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Bg" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="Ring" Width="24" Height="24" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Visibility="Collapsed"/>
          <Border x:Name="Box" Width="18" Height="18" BorderThickness="1.5" BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource InputBg}" VerticalAlignment="Center">
            <Path x:Name="Mark" Data="M 3 8 L 6.5 11.5 L 12.5 4.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Scrolling -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border x:Name="Knob" Margin="3,2" Background="{DynamicResource ScrollThumb}"/>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource ScrollThumbHover}"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource ScrollThumbHover}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/><Setter Property="MinWidth" Value="11"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}"/></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="11"/><Setter Property="MinHeight" Value="11"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Openers: a plain heading line with a chevron; hover marks the line, focus frames it. -->
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderButton" Cursor="Hand" FocusVisualStyle="{x:Null}" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="6,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Path x:Name="Chevron" Data="M 0 0 L 4.5 4.5 L 0 9" Stroke="{DynamicResource Text}" StrokeThickness="1.4" VerticalAlignment="Center" Margin="4,0,14,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path>
                  <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Display}" TextElement.FontWeight="SemiBold"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                  <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="{StaticResource MotionFast}"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="30,4,0,10"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Progress: a flat square bar. -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/><Setter Property="Background" Value="{DynamicResource Track}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid ClipToBounds="True">
          <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
          <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          <Border x:Name="Sweep" Visibility="Collapsed">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
                <GradientStop Offset="0" Color="Transparent"/><GradientStop Offset="0.3" Color="{DynamicResource AccentColor}"/><GradientStop Offset="0.7" Color="{DynamicResource AccentColor}"/><GradientStop Offset="1" Color="Transparent"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsIndeterminate" Value="True">
            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
            <Trigger.EnterActions><BeginStoryboard x:Name="SweepRun"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)" From="-1" To="1" Duration="0:0:1.4"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="SweepRun"/></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="MaxWidth" Value="380"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Padding="10,6">
          <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" Padding="8,8"><ContentPresenter/></Border>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Sections: no cards. A block opens on a 2 px ink rule and is set apart by space, not by a frame. -->
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/><Setter Property="BorderThickness" Value="0,2,0,0"/><Setter Property="Padding" Value="0,14,0,0"/><Setter Property="Margin" Value="0,0,0,24"/></Style>
    <Style x:Key="Chip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface2}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="PageSub" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="Margin" Value="0,0,0,20"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
    <Style x:Key="AutoHide" TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
    <Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <!-- The hanging numeral column: step numbers on İndir, percentages in Kuyruk. -->
    <Style x:Key="Numeral" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="40"/><Setter Property="FontWeight" Value="Light"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="LineHeight" Value="40"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/></Style>
    <Style x:Key="Figures" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- Rail: the one colour field of the window. -->
    <Border x:Name="Sidebar" Width="212" Background="{DynamicResource Sidebar}">
      <DockPanel Margin="12,20,12,16">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="6,0,0,32">
            <Border Width="34" Height="34" Background="{DynamicResource SidebarText}">
              <Path Stroke="{DynamicResource Sidebar}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 8,12 C 12,8 15,16 19,12 C 22,9 24,11 26,12 M 17,15 L 17,25 M 13,21 L 17,25 21,21"/>
            </Border>
            <TextBlock x:Name="BrandText" Text="flow" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" VerticalAlignment="Center" Margin="12,0,0,3"/>
          </StackPanel>
          <RadioButton x:Name="NavDownload" Style="{StaticResource Nav}" IsChecked="True" AutomationProperties.Name="{DynamicResource s.nav.download}" ToolTip="{DynamicResource s.nav.download.tip}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE896;"/><TextBlock x:Name="NavDownloadText" Style="{StaticResource NavText}" Text="{DynamicResource s.nav.download}"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavQueue" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource s.nav.queue}" ToolTip="{DynamicResource s.nav.queue.tip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8FD;"/>
              <TextBlock x:Name="NavQueueText" Style="{StaticResource NavText}" Text="{DynamicResource s.nav.queue}"/>
              <Border x:Name="QueueBadge" Background="{DynamicResource SidebarActive}" MinWidth="22" Height="20" Padding="6,0" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="QueueBadgeText" Foreground="{DynamicResource SidebarText}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource s.nav.history}" ToolTip="{DynamicResource s.nav.history.tip}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;"/><TextBlock x:Name="NavHistoryText" Style="{StaticResource NavText}" Text="{DynamicResource s.nav.history}"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource s.nav.settings}" ToolTip="{DynamicResource s.nav.settings.tip}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;"/><TextBlock x:Name="NavSettingsText" Style="{StaticResource NavText}" Text="{DynamicResource s.nav.settings}"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="SidebarActivity" Background="{DynamicResource SidebarActive}" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed" Cursor="Hand" ToolTip="{DynamicResource s.nav.queue.tip}">
            <StackPanel>
              <TextBlock x:Name="SidebarActivityText" Foreground="{DynamicResource SidebarText}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap"/>
              <ProgressBar x:Name="SidebarProgress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Foreground="{DynamicResource SidebarText}" Background="{DynamicResource SidebarHover}"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource SidebarMuted}" FontFamily="{StaticResource Display}" FontSize="11.5" Margin="6,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- Header: the page title flush left (HeaderEyebrow keeps its name; App.ShowPage sets the title), status right. -->
      <Grid Margin="32,20,32,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="HeaderEyebrow" Style="{StaticResource PageTitle}" Text="{DynamicResource s.dl.title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Border x:Name="StatusChip" Grid.Column="1" Background="{DynamicResource AccentSoft}" Padding="10,4" VerticalAlignment="Center">
          <TextBlock x:Name="StatusChipText" Text="{DynamicResource s.status.ready}" Foreground="{DynamicResource AccentText}" FontFamily="{StaticResource Display}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
        </Border>
      </Grid>

      <!-- Download page: three numbered steps hang on the numeral column; İndir lives in the action bar below. -->
      <ScrollViewer x:Name="DownloadPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="32,0,26,28">
          <!-- Measure: the form column stops at 1000 px and stays flush left; the last column takes the rest. -->
          <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="0.001*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="2" Style="{StaticResource PageSub}" Text="{DynamicResource s.dl.subtitle}"/>

          <!-- 1 · the link and what it really contains -->
          <TextBlock Grid.Row="1" Style="{StaticResource Numeral}" Text="1" Margin="0,8,0,0"/>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.dl.link}"/>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                <UniformGrid x:Name="PlatformTabs" Rows="1" MaxWidth="640" HorizontalAlignment="Left" KeyboardNavigation.DirectionalNavigation="Cycle">
                  <RadioButton x:Name="TabYouTube" Style="{StaticResource Segment}" Tag="YouTube" Content="YouTube" IsChecked="True" Margin="0,0,0,-1"/>
                  <RadioButton x:Name="TabInstagram" Style="{StaticResource Segment}" Tag="Instagram" Content="Instagram" Margin="0,0,0,-1"/>
                  <RadioButton x:Name="TabTikTok" Style="{StaticResource Segment}" Tag="TikTok" Content="TikTok" Margin="0,0,0,-1"/>
                  <RadioButton x:Name="TabOther" Style="{StaticResource Segment}" Tag="Other" Content="{DynamicResource s.tab.other}" Margin="0,0,0,-1"/>
                </UniformGrid>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Tag="{DynamicResource s.dl.placeholder}" AutomationProperties.Name="{DynamicResource s.dl.link}" ToolTip="{DynamicResource s.dl.link.tip}"/>
                <Button x:Name="PasteButton" Grid.Column="1" Margin="8,0,0,0" ToolTip="{DynamicResource s.dl.paste.tip}" AutomationProperties.Name="{DynamicResource s.dl.paste}">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource s.dl.paste}"/></StackPanel>
                </Button>
                <Button x:Name="InspectButton" Grid.Column="2" Margin="8,0,0,0" Content="{DynamicResource s.dl.inspect}" ToolTip="{DynamicResource s.dl.inspect.tip}"/>
              </Grid>
              <TextBlock x:Name="TabHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
              <Expander x:Name="SupportExpander" Margin="-6,6,0,0" Visibility="Collapsed" Header="{DynamicResource s.sites.title}" AutomationProperties.Name="{DynamicResource s.sites.title}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.sites.note}" Margin="0,0,0,10"/>
                  <ItemsControl x:Name="KnownSites" Focusable="False">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="Chip" Grid.Column="1" Padding="8,1" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                          <TextBlock x:Name="ChipText" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding NoteText}" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="done"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="warning"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="error"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.sites.engine}" Margin="0,12,0,6"/>
                  <TextBox x:Name="SiteSearch" Tag="{DynamicResource s.sites.search}" AutomationProperties.Name="{DynamicResource s.sites.search}"/>
                  <TextBlock x:Name="SiteCount" Style="{StaticResource Hint}" Margin="0,6,0,6"/>
                  <ListBox x:Name="SiteList" MaxHeight="220" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{DynamicResource s.sites.engine}"/>
                </StackPanel>
              </Expander>
              <Border x:Name="RedirectNote" Background="{DynamicResource InfoSoft}" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="RedirectText" Foreground="{DynamicResource Info}" FontSize="12.5" TextWrapping="Wrap"/>
              </Border>

              <Border x:Name="PreviewCard" Background="Transparent" Margin="0,18,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border x:Name="ThumbBox" Background="{DynamicResource AccentSoft}" Width="160" Height="90" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid>
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="26" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                      <Image x:Name="Thumbnail" Stretch="UniformToFill" Visibility="Collapsed"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                    <TextBlock x:Name="VideoTitle" Text="{DynamicResource s.preview.empty.title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="VideoMeta" Text="{DynamicResource s.preview.empty.meta}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <WrapPanel x:Name="Chips" Margin="0,10,0,0"/>
                    <ProgressBar x:Name="PreviewProgress" IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <Button x:Name="OpenListButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-10,4,0,0" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource s.col.openList}"/></StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock x:Name="PreviewNote" Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- A list or multi-item post: its items, between the link and the choice -->
          <Border x:Name="CollectionCard" Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="CollectionTitle" Style="{StaticResource Section}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CollectionMeta" Style="{StaticResource Hint}"/>
                </StackPanel>
                <Button x:Name="CloseCollectionButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" ToolTip="{DynamicResource s.col.close}" AutomationProperties.Name="{DynamicResource s.col.close}"/>
              </Grid>
              <ProgressBar x:Name="CollectionProgress" IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="Collapsed"/>
              <WrapPanel Margin="-10,8,0,6">
                <Button x:Name="SelectAllButton" Style="{StaticResource Ghost}" Content="{DynamicResource s.col.selectAll}"/>
                <Button x:Name="SelectNoneButton" Style="{StaticResource Ghost}" Content="{DynamicResource s.col.selectNone}"/>
                <Button x:Name="LoadMoreButton" Style="{StaticResource Ghost}" Content="{DynamicResource s.col.loadMore}" Visibility="Collapsed"/>
                <Button x:Name="StopListingButton" Style="{StaticResource Ghost}" Content="{DynamicResource s.col.stop}" Visibility="Collapsed"/>
              </WrapPanel>
              <ListBox x:Name="CollectionList" MaxHeight="380" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{DynamicResource s.col.items}">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Selectable}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" Padding="0"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource AutoHide}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Figures}" Foreground="{DynamicResource TextMuted}" FontSize="13" VerticalAlignment="Center" Margin="12,0,4,0"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="CollectionNote" Style="{StaticResource AutoHide}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- 2 · the file that will be made -->
          <TextBlock Grid.Row="3" Style="{StaticResource Numeral}" Text="2" Margin="0,8,0,0"/>
          <Border x:Name="OptionsCard" Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.opt.title}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.opt.profile}"/>
                  <ComboBox x:Name="ProfileBox" AutomationProperties.Name="{DynamicResource s.opt.profile}">
                    <ComboBoxItem Tag="compatible" Content="{DynamicResource s.profile.compatible}"/>
                    <ComboBoxItem Tag="best" Content="{DynamicResource s.profile.best}"/>
                    <ComboBoxItem Tag="small" Content="{DynamicResource s.profile.small}"/>
                    <ComboBoxItem Tag="mp3" Content="{DynamicResource s.profile.mp3}"/>
                    <ComboBoxItem Tag="m4a" Content="{DynamicResource s.profile.m4a}"/>
                    <ComboBoxItem Tag="custom" Content="{DynamicResource s.profile.custom}"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.opt.format}"/>
                  <ComboBox x:Name="FormatBox" AutomationProperties.Name="{DynamicResource s.opt.format}">
                    <ComboBoxItem Tag="mp4" Content="{DynamicResource s.format.mp4}"/>
                    <ComboBoxItem Tag="mkv" Content="{DynamicResource s.format.mkv}"/>
                    <ComboBoxItem Tag="mp3" Content="{DynamicResource s.format.mp3}"/>
                    <ComboBoxItem Tag="m4a" Content="{DynamicResource s.format.m4a}"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.opt.quality}"/>
                  <ComboBox x:Name="QualityBox" AutomationProperties.Name="{DynamicResource s.opt.quality}"/>
                </StackPanel>
              </Grid>
              <Border x:Name="SelectionPanel" Background="{DynamicResource Surface2}" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock x:Name="SelectionSummary" Style="{StaticResource Figures}" FontSize="13.5" TextWrapping="Wrap"/>
                  <TextBlock x:Name="SelectionWarning" Foreground="{DynamicResource Warning}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- 3 · where it goes -->
          <TextBlock Grid.Row="4" Style="{StaticResource Numeral}" Text="3" Margin="0,8,0,0"/>
          <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.opt.folder}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="{DynamicResource s.opt.folder}"/>
                <Button x:Name="FolderButton" Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource s.common.change}"/>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                  <TextBlock Text="{DynamicResource s.opt.duplicate}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                  <ComboBox x:Name="DuplicateBox" MinWidth="170" AutomationProperties.Name="{DynamicResource s.opt.duplicate}" ToolTip="{DynamicResource s.opt.duplicate.tip}">
                    <ComboBoxItem Tag="rename" Content="{DynamicResource s.dup.rename}"/>
                    <ComboBoxItem Tag="skip" Content="{DynamicResource s.dup.skip}"/>
                  </ComboBox>
                </StackPanel>
              </WrapPanel>
              <TextBlock x:Name="NamePreview" Style="{StaticResource AutoHide}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>

          <!-- Openers: every advanced setting one click away, none in the main path -->
          <Border Grid.Row="5" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <StackPanel>
              <Expander x:Name="FormatExpander" Margin="-6,0,0,0" Header="{DynamicResource s.opt.details}" AutomationProperties.Name="{DynamicResource s.opt.details}">
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="{DynamicResource s.opt.codec}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox x:Name="CodecBox" MinWidth="150" AutomationProperties.Name="{DynamicResource s.opt.codec}">
                      <ComboBoxItem Tag="auto" Content="{DynamicResource s.codec.auto}"/>
                      <ComboBoxItem Tag="h264" Content="{DynamicResource s.codec.h264}"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                    <TextBlock Text="{DynamicResource s.opt.fps}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox x:Name="FpsBox" MinWidth="130" AutomationProperties.Name="{DynamicResource s.opt.fps}">
                      <ComboBoxItem Tag="0" Content="{DynamicResource s.fps.source}"/>
                      <ComboBoxItem Tag="60" Content="{DynamicResource s.fps.60}"/>
                      <ComboBoxItem Tag="30" Content="{DynamicResource s.fps.30}"/>
                    </ComboBox>
                  </StackPanel>
                  <CheckBox x:Name="StrictBox" Content="{DynamicResource s.opt.strict}" ToolTip="{DynamicResource s.opt.strict.tip}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </WrapPanel>
              </Expander>
              <Expander x:Name="SubtitleExpander" Margin="-6,0,0,0" AutomationProperties.Name="{DynamicResource s.subs.title}">
                <Expander.Header><TextBlock x:Name="SubtitleHeader" Text="{DynamicResource s.subs.title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14"/></Expander.Header>
                <StackPanel>
                  <TextBlock x:Name="SubtitleNote" Style="{StaticResource AutoHide}" Margin="0,0,0,8"/>
                  <WrapPanel x:Name="SubtitleList"/>
                  <CheckBox x:Name="AutoSubsBox" Content="{DynamicResource s.subs.auto}" Margin="0,8,0,0"/>
                  <WrapPanel x:Name="AutoSubtitleList" Margin="0,8,0,0"/>
                  <Button x:Name="AllAutoSubsButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource s.subs.mode}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox x:Name="SubModeBox" MinWidth="200" AutomationProperties.Name="{DynamicResource s.subs.mode}">
                      <ComboBoxItem Tag="file" Content="{DynamicResource s.subs.file}"/>
                      <ComboBoxItem Tag="embed" Content="{DynamicResource s.subs.embed}"/>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Expander x:Name="ClipExpander" Margin="-6,0,0,0" AutomationProperties.Name="{DynamicResource s.clip.title}">
                <Expander.Header><TextBlock x:Name="ClipHeader" Text="{DynamicResource s.clip.title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14"/></Expander.Header>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.clip.start}"/>
                      <TextBox x:Name="ClipStartBox" Tag="0:00" AutomationProperties.Name="{DynamicResource s.clip.start}" ToolTip="{DynamicResource s.clip.hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.clip.end}"/>
                      <TextBox x:Name="ClipEndBox" AutomationProperties.Name="{DynamicResource s.clip.end}" ToolTip="{DynamicResource s.clip.hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.clip.chapter}"/>
                      <ComboBox x:Name="ChapterBox" AutomationProperties.Name="{DynamicResource s.clip.chapter}"/>
                    </StackPanel>
                  </Grid>
                  <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource s.clip.mode}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox x:Name="ClipModeBox" MinWidth="260" AutomationProperties.Name="{DynamicResource s.clip.mode}">
                      <ComboBoxItem Tag="fast" Content="{DynamicResource s.clip.fast}"/>
                      <ComboBoxItem Tag="precise" Content="{DynamicResource s.clip.precise}"/>
                    </ComboBox>
                    <Button x:Name="ClearClipButton" Style="{StaticResource Ghost}" Content="{DynamicResource s.clip.clear}" Margin="8,0,0,0"/>
                  </WrapPanel>
                  <TextBlock x:Name="ClipNote" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
              </Expander>
              <Expander x:Name="ScheduleExpander" Margin="-6,0,0,0" AutomationProperties.Name="{DynamicResource s.sched.title}">
                <Expander.Header><TextBlock x:Name="ScheduleHeader" Text="{DynamicResource s.sched.title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14"/></Expander.Header>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.sched.speed}"/>
                      <ComboBox x:Name="SpeedBox" AutomationProperties.Name="{DynamicResource s.sched.speed}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.sched.start}"/>
                      <ComboBox x:Name="StartModeBox" AutomationProperties.Name="{DynamicResource s.sched.start}">
                        <ComboBoxItem Tag="now" Content="{DynamicResource s.sched.now}"/>
                        <ComboBoxItem Tag="at" Content="{DynamicResource s.sched.at}"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="ScheduleWhen" Grid.Column="4">
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.sched.when}"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ScheduleDateBox" AutomationProperties.Name="{DynamicResource s.sched.when}"/>
                        <TextBox x:Name="ScheduleTimeBox" Grid.Column="2" Tag="21:30" AutomationProperties.Name="{DynamicResource s.sched.when}"/>
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="ScheduleNote" Style="{StaticResource Hint}" Text="{DynamicResource s.sched.note}" Margin="0,8,0,0"/>
                </StackPanel>
              </Expander>
              <Expander x:Name="FileExpander" Margin="-6,0,0,0" Header="{DynamicResource s.opt.files}" AutomationProperties.Name="{DynamicResource s.opt.files}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.opt.organize}"/>
                      <ComboBox x:Name="OrganizeBox" AutomationProperties.Name="{DynamicResource s.opt.organize}">
                        <ComboBoxItem Tag="none" Content="{DynamicResource s.org.none}"/>
                        <ComboBoxItem Tag="platform" Content="{DynamicResource s.org.platform}"/>
                        <ComboBoxItem Tag="platform-channel" Content="{DynamicResource s.org.channel}"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.opt.template}"/>
                      <ComboBox x:Name="TemplatePresetBox" AutomationProperties.Name="{DynamicResource s.opt.template}">
                        <ComboBoxItem Tag="{}{title} [{id}]" Content="{DynamicResource s.tpl.default}"/>
                        <ComboBoxItem Tag="{}{title}" Content="{DynamicResource s.tpl.title}"/>
                        <ComboBoxItem Tag="{}{channel} - {title}" Content="{DynamicResource s.tpl.channel}"/>
                        <ComboBoxItem Tag="{}{date} {title}" Content="{DynamicResource s.tpl.date}"/>
                        <ComboBoxItem Tag="{}{index} {title}" Content="{DynamicResource s.tpl.index}"/>
                        <ComboBoxItem Tag="custom" Content="{DynamicResource s.tpl.custom}"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <TextBox x:Name="TemplateBox" Margin="0,10,0,0" FontFamily="Consolas" AutomationProperties.Name="{DynamicResource s.opt.template}" ToolTip="{DynamicResource s.opt.template.tip}"/>
                  <TextBlock x:Name="TemplateHint" Style="{StaticResource Hint}" Text="{DynamicResource s.opt.template.tip}" Margin="0,6,0,0"/>
                  <CheckBox x:Name="CollectionFolderBox" Content="{DynamicResource s.opt.collectionFolder}" Margin="0,10,0,0"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Queue page: rows on hairlines. The numeral column carries each job's percentage or state mark;
           the running job's cell is the screen's one reversed plate. -->
      <ScrollViewer x:Name="QueuePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
        <Grid Margin="32,0,26,28">
          <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="0.001*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="2" Style="{StaticResource PageSub}" Text="{DynamicResource s.queue.subtitle}"/>
          <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <ComboBox x:Name="QueueFilterBox" MinWidth="190" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource s.queue.filter}">
              <ComboBoxItem Tag="all" Content="{DynamicResource s.filter.allPlatforms}"/>
              <ComboBoxItem Tag="YouTube" Content="YouTube"/>
              <ComboBoxItem Tag="Instagram" Content="Instagram"/>
              <ComboBoxItem Tag="TikTok" Content="TikTok"/>
              <ComboBoxItem Tag="Other" Content="{DynamicResource s.tab.other}"/>
            </ComboBox>
            <Button x:Name="ResumeAllButton" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource s.queue.resumeAll}"/></StackPanel></Button>
            <Button x:Name="PauseAllButton" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource s.queue.pauseAll}"/></StackPanel></Button>
            <Button x:Name="ClearFinishedButton" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource s.queue.clear}"/></StackPanel></Button>
          </WrapPanel>
          <Border x:Name="QueueEmpty" Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.queue.empty}"/>
              <Button x:Name="QueueGoDownload" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-10,8,0,0" Content="{DynamicResource s.queue.add}"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Grid.ColumnSpan="2">
            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/><Setter Property="BorderThickness" Value="0,2,0,0"/>
              <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=QueueList}" Value="False"><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <ItemsControl x:Name="QueueList" Focusable="False" AutomationProperties.Name="{DynamicResource s.queue.title}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <!-- The numeral cell: percentage while running (reversed plate), a mark otherwise -->
                    <Border x:Name="FigureCell" Margin="0,0,10,0">
                      <Grid Margin="0,12,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock x:Name="Figure" Text="{Binding PercentText}" Style="{StaticResource Numeral}" FontSize="20" LineHeight="24" Margin="4,0,4,2" Visibility="Collapsed"/>
                        <TextBlock x:Name="Mark" Style="{StaticResource Glyph}" Text="&#xE738;" FontSize="16" Foreground="{DynamicResource TextMuted}" Margin="4,4,0,0"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,12,0,12">
                      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                      <WrapPanel Margin="0,4,0,0">
                        <Border x:Name="SourceKey" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Background="{DynamicResource SourceOther}"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="StateChip" Padding="7,1" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                          <TextBlock x:Name="StateLabel" Text="{Binding StateText}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        </Border>
                        <TextBlock Text="{Binding StageText}" FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </WrapPanel>
                      <ProgressBar Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}"/>
                      <TextBlock Text="{Binding DetailText}" Style="{StaticResource AutoHide}" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0"/>
                      <TextBlock Text="{Binding NoteText}" Foreground="{DynamicResource Info}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                      <Border Background="{DynamicResource DangerSoft}" Padding="12,8" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                        <StackPanel>
                          <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
                          <WrapPanel Margin="-10,4,0,0">
                            <Button Style="{StaticResource Ghost}" Tag="retry" Content="{DynamicResource s.job.retry}" Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource Ghost}" Tag="resume" Content="{DynamicResource s.job.continue}" Visibility="{Binding CanResume, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource Ghost}" Tag="folder" Content="{DynamicResource s.job.fixFolder}" Visibility="{Binding CanFixFolder, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource Ghost}" Tag="format" Content="{DynamicResource s.job.fixFormat}" Visibility="{Binding CanFixFormat, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource Ghost}" Tag="copy" Content="{DynamicResource s.job.copy}"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,8,-6,0">
                      <Button Style="{StaticResource IconButton}" Tag="pause" Content="&#xE769;" ToolTip="{DynamicResource s.job.pause}" AutomationProperties.Name="{DynamicResource s.job.pause}" Visibility="{Binding CanPause, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="resume" Content="&#xE768;" ToolTip="{DynamicResource s.job.resume}" AutomationProperties.Name="{DynamicResource s.job.resume}" Visibility="{Binding CanResume, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="retry" Content="&#xE72C;" ToolTip="{DynamicResource s.job.retry}" AutomationProperties.Name="{DynamicResource s.job.retry}" Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="reveal" Content="&#xE838;" ToolTip="{DynamicResource s.common.reveal}" AutomationProperties.Name="{DynamicResource s.common.reveal}" Visibility="{Binding CanReveal, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="up" Content="&#xE70E;" ToolTip="{DynamicResource s.job.up}" AutomationProperties.Name="{DynamicResource s.job.up}" Visibility="{Binding CanMove, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="down" Content="&#xE70D;" ToolTip="{DynamicResource s.job.down}" AutomationProperties.Name="{DynamicResource s.job.down}" Visibility="{Binding CanMove, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="cancel" Content="&#xE711;" ToolTip="{DynamicResource s.job.cancel}" AutomationProperties.Name="{DynamicResource s.job.cancel}" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="remove" Content="&#xE74D;" ToolTip="{DynamicResource s.job.remove}" AutomationProperties.Name="{DynamicResource s.job.remove}" Visibility="{Binding CanRemove, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding StateKind}" Value="active">
                    <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource AccentText}"/>
                    <Setter TargetName="Mark" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding StateKind}" Value="done"><Setter TargetName="StateChip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource Success}"/><Setter TargetName="Mark" Property="Text" Value="&#xE73E;"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                  <DataTrigger Binding="{Binding StateKind}" Value="error"><Setter TargetName="StateChip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource Danger}"/><Setter TargetName="Mark" Property="Text" Value="&#xE7BA;"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                  <DataTrigger Binding="{Binding StateKind}" Value="warning"><Setter TargetName="StateChip" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource Warning}"/><Setter TargetName="Mark" Property="Text" Value="&#xE72C;"/><Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                  <DataTrigger Binding="{Binding StateKey}" Value="paused"><Setter TargetName="Mark" Property="Text" Value="&#xE769;"/></DataTrigger>
                  <DataTrigger Binding="{Binding StateKey}" Value="scheduled"><Setter TargetName="Mark" Property="Text" Value="&#xE823;"/></DataTrigger>
                  <DataTrigger Binding="{Binding PlatformKey}" Value="YouTube"><Setter TargetName="SourceKey" Property="Background" Value="{DynamicResource SourceYouTube}"/></DataTrigger>
                  <DataTrigger Binding="{Binding PlatformKey}" Value="Instagram"><Setter TargetName="SourceKey" Property="Background" Value="{DynamicResource SourceInstagram}"/></DataTrigger>
                  <DataTrigger Binding="{Binding PlatformKey}" Value="TikTok"><Setter TargetName="SourceKey" Property="Background" Value="{DynamicResource SourceTikTok}"/></DataTrigger>
                  <!-- Running with a known percentage: the figure replaces the mark and the cell turns into the reversed plate. -->
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding StateKind}" Value="active"/><Condition Binding="{Binding Indeterminate}" Value="False"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="Figure" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Figure" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                    <Setter TargetName="FigureCell" Property="Background" Value="{DynamicResource Accent}"/>
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding StateKind}" Value="active"/><Condition Binding="{Binding Indeterminate}" Value="True"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Mark" Property="Text" Value="&#xE896;"/>
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource AccentText}"/>
                  </MultiDataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- History page: the same row language as the queue; the numeral column carries the day each file was made. -->
      <ScrollViewer x:Name="HistoryPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
        <Grid Margin="32,0,26,28">
          <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="0.001*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="2" Style="{StaticResource PageSub}" Text="{DynamicResource s.hist.subtitle}"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition MinWidth="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="HistorySearch" Tag="{DynamicResource s.hist.search}" AutomationProperties.Name="{DynamicResource s.hist.search}" Margin="0,0,8,8"/>
            <WrapPanel Grid.Column="1">
              <ComboBox x:Name="HistoryPlatformBox" MinWidth="160" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource s.queue.filter}">
                <ComboBoxItem Tag="all" Content="{DynamicResource s.filter.allPlatforms}"/>
                <ComboBoxItem Tag="YouTube" Content="YouTube"/>
                <ComboBoxItem Tag="Instagram" Content="Instagram"/>
                <ComboBoxItem Tag="TikTok" Content="TikTok"/>
                <ComboBoxItem Tag="Other" Content="{DynamicResource s.tab.other}"/>
              </ComboBox>
              <ComboBox x:Name="HistoryStatusBox" MinWidth="150" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource s.hist.status}">
                <ComboBoxItem Tag="all" Content="{DynamicResource s.hist.status.all}"/>
                <ComboBoxItem Tag="completed" Content="{DynamicResource s.hist.status.completed}"/>
                <ComboBoxItem Tag="failed" Content="{DynamicResource s.hist.status.failed}"/>
                <ComboBoxItem Tag="canceled" Content="{DynamicResource s.hist.status.canceled}"/>
                <ComboBoxItem Tag="skipped" Content="{DynamicResource s.hist.status.skipped}"/>
              </ComboBox>
              <ComboBox x:Name="HistoryDateBox" MinWidth="140" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource s.hist.date}">
                <ComboBoxItem Tag="all" Content="{DynamicResource s.hist.date.all}"/>
                <ComboBoxItem Tag="1" Content="{DynamicResource s.hist.date.today}"/>
                <ComboBoxItem Tag="7" Content="{DynamicResource s.hist.date.week}"/>
                <ComboBoxItem Tag="30" Content="{DynamicResource s.hist.date.month}"/>
              </ComboBox>
            </WrapPanel>
          </Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HistoryCount" Style="{StaticResource Figures}" Foreground="{DynamicResource TextMuted}" FontSize="13" VerticalAlignment="Center"/>
            <Button x:Name="ClearHistoryButton" Grid.Column="1" Style="{StaticResource Ghost}" Content="{DynamicResource s.hist.clear}" ToolTip="{DynamicResource s.hist.clear.tip}"/>
          </Grid>
          <Border x:Name="HistoryEmpty" Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}"><TextBlock x:Name="HistoryEmptyText" Style="{StaticResource Hint}" Text="{DynamicResource s.hist.empty}"/></Border>
          <Border Grid.Row="4" Grid.ColumnSpan="2">
            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/><Setter Property="BorderThickness" Value="0,2,0,0"/>
              <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=HistoryList}" Value="False"><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <ItemsControl x:Name="HistoryList" Focusable="False" AutomationProperties.Name="{DynamicResource s.hist.title}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Figure" Text="{Binding DayText}" Style="{StaticResource Figures}" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource TextMuted}" Margin="0,13,0,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="0,12,0,12">
                      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                      <WrapPanel Margin="0,4,0,0">
                        <Border x:Name="SourceKey" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Background="{DynamicResource SourceOther}"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" Margin="0,0,10,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Border x:Name="StatusChip" Padding="7,1" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                          <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding PathText}" Style="{StaticResource AutoHide}" Foreground="{DynamicResource TextFaint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                      <TextBlock Text="{Binding ErrorText}" Style="{StaticResource AutoHide}" Foreground="{DynamicResource Danger}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,8,-6,0">
                      <Button Style="{StaticResource IconButton}" Tag="reveal" Content="&#xE838;" ToolTip="{DynamicResource s.common.reveal}" AutomationProperties.Name="{DynamicResource s.common.reveal}" Visibility="{Binding CanReveal, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="source" Content="&#xE71B;" ToolTip="{DynamicResource s.hist.source}" AutomationProperties.Name="{DynamicResource s.hist.source}" Visibility="{Binding HasSource, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="requeue" Content="&#xE72C;" ToolTip="{DynamicResource s.hist.requeue}" AutomationProperties.Name="{DynamicResource s.hist.requeue}" Visibility="{Binding HasSource, Converter={StaticResource Vis}}"/>
                      <Button Style="{StaticResource IconButton}" Tag="forget" Content="&#xE74D;" ToolTip="{DynamicResource s.hist.forget}" AutomationProperties.Name="{DynamicResource s.hist.forget}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="done"><Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="error"><Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="missing"><Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                  <DataTrigger Binding="{Binding PlatformKey}" Value="YouTube"><Setter TargetName="SourceKey" Property="Background" Value="{DynamicResource SourceYouTube}"/></DataTrigger>
                  <DataTrigger Binding="{Binding PlatformKey}" Value="Instagram"><Setter TargetName="SourceKey" Property="Background" Value="{DynamicResource SourceInstagram}"/></DataTrigger>
                  <DataTrigger Binding="{Binding PlatformKey}" Value="TikTok"><Setter TargetName="SourceKey" Property="Background" Value="{DynamicResource SourceTikTok}"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>
      </ScrollViewer>

      <!-- Settings page -->
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
        <Grid Margin="32,0,26,28">
          <!-- Settings: marginal headings on the left grid line, every control on one vertical line to their right. -->
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1052"/><ColumnDefinition Width="0.001*"/></Grid.ColumnDefinitions>
          <StackPanel>
          <TextBlock Style="{StaticResource PageSub}" Text="{DynamicResource s.set.subtitle}"/>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.appearance}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.language}"/>
                  <ComboBox x:Name="LanguageBox" AutomationProperties.Name="{DynamicResource s.set.language}">
                    <ComboBoxItem Tag="system" Content="{DynamicResource s.set.language.system}"/>
                    <ComboBoxItem Tag="tr" Content="Türkçe"/>
                    <ComboBoxItem Tag="en" Content="English"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.theme}"/>
                  <ComboBox x:Name="ThemeBox" AutomationProperties.Name="{DynamicResource s.set.theme}">
                    <ComboBoxItem Tag="system" Content="{DynamicResource s.set.theme.system}"/>
                    <ComboBoxItem Tag="light" Content="{DynamicResource s.set.theme.light}"/>
                    <ComboBoxItem Tag="dark" Content="{DynamicResource s.set.theme.dark}"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.language.note}" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.downloads}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.folder}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DefaultFolderBox" IsReadOnly="True" AutomationProperties.Name="{DynamicResource s.set.folder}"/>
                <Button x:Name="DefaultFolderButton" Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource s.common.change}"/>
                <Button x:Name="OpenDefaultFolderButton" Grid.Column="2" Margin="8,0,0,0" Content="{DynamicResource s.common.open}"/>
              </Grid>
              <CheckBox x:Name="AutoPreviewBox" Content="{DynamicResource s.set.autopreview}" Margin="0,16,0,0"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.autopreview.note}" Margin="30,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.queue}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.parallel}"/>
                  <ComboBox x:Name="ParallelBox" AutomationProperties.Name="{DynamicResource s.set.parallel}">
                    <ComboBoxItem Tag="1" Content="{DynamicResource s.set.parallel.1}"/>
                    <ComboBoxItem Tag="2" Content="2"/>
                    <ComboBoxItem Tag="3" Content="3"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.retries}"/>
                  <ComboBox x:Name="RetriesBox" AutomationProperties.Name="{DynamicResource s.set.retries}">
                    <ComboBoxItem Tag="0" Content="{DynamicResource s.set.retries.0}"/>
                    <ComboBoxItem Tag="1" Content="1"/>
                    <ComboBoxItem Tag="2" Content="2"/>
                    <ComboBoxItem Tag="3" Content="3"/>
                    <ComboBoxItem Tag="5" Content="5"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.retries.note}" Margin="0,8,0,0"/>
              <CheckBox x:Name="ResumeBox" Content="{DynamicResource s.set.resume}" Margin="0,14,0,0"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.resume.note}" Margin="30,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.speed}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.defaultSpeed}"/>
                  <ComboBox x:Name="DefaultSpeedBox" AutomationProperties.Name="{DynamicResource s.set.defaultSpeed}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Label}" Text="{DynamicResource s.set.missed}"/>
                  <ComboBox x:Name="MissedBox" AutomationProperties.Name="{DynamicResource s.set.missed}">
                    <ComboBoxItem Tag="start" Content="{DynamicResource s.set.missed.start}"/>
                    <ComboBoxItem Tag="hold" Content="{DynamicResource s.set.missed.hold}"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="WindowsTaskBox" Content="{DynamicResource s.set.windowsTask}" Margin="0,14,0,0"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.windowsTask.note}" Margin="30,4,0,0"/>
              <TextBlock x:Name="WindowsTaskStatus" Style="{StaticResource AutoHide}" Margin="30,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.window}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <CheckBox x:Name="MinimizeTrayBox" Content="{DynamicResource s.set.minimizeTray}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.closeChoice.note}" Margin="0,12,0,0"/>
              <CheckBox x:Name="NotifyBox" Content="{DynamicResource s.set.notify}" Margin="0,12,0,0"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.notify.note}" Margin="30,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.comp.title}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <ItemsControl x:Name="ComponentList" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12.5"/>
                    <Border x:Name="Chip" Grid.Column="2" Padding="8,1" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                      <TextBlock x:Name="ChipText" Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="done"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="active"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentText}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="error"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.comp.note}" Margin="0,4,0,0"/>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="CheckComponentsButton" Content="{DynamicResource s.comp.check}" Margin="0,0,8,8"/>
                <Button x:Name="UpdateButton" Content="{DynamicResource s.set.engine.update}" Margin="0,0,8,8" ToolTip="{DynamicResource s.comp.update.tip}"/>
                <Button x:Name="RollbackButton" Content="{DynamicResource s.comp.rollback}" Margin="0,0,8,8" Visibility="Collapsed"/>
              </WrapPanel>
              <ProgressBar x:Name="ComponentProgress" IsIndeterminate="True" Height="4" Margin="0,4,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="ComponentStatusText" Style="{StaticResource AutoHide}" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.data}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <TextBlock x:Name="DataFolderText" Style="{StaticResource Hint}"/>
              <TextBlock x:Name="ImportText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="OpenDataButton" Content="{DynamicResource s.set.data.open}" Margin="0,0,8,8"/>
                <Button x:Name="CopyDiagnosticsButton" Content="{DynamicResource s.set.diagnostics}" Margin="0,0,8,8" ToolTip="{DynamicResource s.set.diagnostics.tip}"/>
              </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource s.set.about}" TextWrapping="Wrap" Margin="0,0,16,12"/>
              <StackPanel Grid.Column="1">
              <TextBlock x:Name="AboutText" Style="{StaticResource Hint}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.set.about.note}" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <!-- Notice shown above every page -->
      <!-- İndir's action bar: the screen's one reversed plate stays in view while the form scrolls. -->
      <Border x:Name="DownloadActions" Grid.Row="2" Visibility="{Binding Visibility, ElementName=DownloadPage}" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0,1,0,0" Padding="32,12,37,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="0.001*"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Style="{StaticResource Primary}" MinHeight="46" FontSize="16" HorizontalContentAlignment="Stretch" ToolTip="{DynamicResource s.dl.start.tip}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Margin="0,0,10,0"/><TextBlock x:Name="StartText" Text="{DynamicResource s.dl.start}"/></StackPanel>
            </Button>
            <Button x:Name="AddHoldButton" Grid.Column="1" Margin="10,0,0,0" MinHeight="46" ToolTip="{DynamicResource s.dl.hold.tip}">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource s.dl.hold}"/></StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- Notice: a flat square bar on the content column's left line, above İndir's action bar. -->
      <Border x:Name="MessageBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="780" MinWidth="320" Margin="84,0,37,18" Padding="16,8,8,8" Visibility="Collapsed" Background="{DynamicResource InfoSoft}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Info}"/>
          <Button x:Name="MessageAction" Grid.Column="1" Style="{StaticResource Ghost}" Visibility="Collapsed" Margin="8,0,0,0"/>
          <Button x:Name="MessageClose" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="32" Height="32" MinHeight="32" FontSize="11" Margin="4,0,0,0" ToolTip="{DynamicResource s.common.close}" AutomationProperties.Name="{DynamicResource s.common.close}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

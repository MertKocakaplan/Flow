<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow" Width="488" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <!-- Styles and the Display font come from the main window's resources, merged after load: use DynamicResource only. -->
  <StackPanel Margin="28,24,28,24" KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Text="{DynamicResource s.close.title}" FontFamily="{DynamicResource Display}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource s.close.subtitle}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,18"/>
    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0,2,0,0" Padding="0,18,0,0">
      <StackPanel>
        <Border x:Name="ActiveNotice" Background="{DynamicResource InfoSoft}" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
          <TextBlock x:Name="ActiveText" Foreground="{DynamicResource Info}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <!-- The window's one reversed plate: keeping downloads running is the default answer. -->
        <Button x:Name="TrayButton" IsDefault="True" HorizontalContentAlignment="Stretch" Padding="16,14"
                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                AutomationProperties.Name="{DynamicResource s.close.tray}" AutomationProperties.HelpText="{DynamicResource s.close.tray.note}">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.close.tray}" FontSize="16" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource s.close.tray.note}" FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <Button x:Name="ExitButton" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,10,0,0"
                AutomationProperties.Name="{DynamicResource s.close.exit}" AutomationProperties.HelpText="{DynamicResource s.close.exit.note}">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.close.exit}" FontSize="16" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource s.close.exit.note}" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <Button x:Name="CancelButton" Content="{DynamicResource s.close.cancel}" IsCancel="True" HorizontalAlignment="Right" MinWidth="104" Margin="0,20,0,0"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>

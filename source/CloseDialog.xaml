<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow" Width="488" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="24" KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Text="{DynamicResource s.close.title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource s.close.subtitle}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
    <Border x:Name="ActiveNotice" Background="{DynamicResource InfoSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
      <TextBlock x:Name="ActiveText" Foreground="{DynamicResource Info}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    <Button x:Name="TrayButton" IsDefault="True" HorizontalContentAlignment="Stretch" Padding="16,14"
            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
            AutomationProperties.Name="{DynamicResource s.close.tray}" AutomationProperties.HelpText="{DynamicResource s.close.tray.note}">
      <StackPanel>
        <TextBlock Text="{DynamicResource s.close.tray}" Foreground="{DynamicResource AccentText}" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource s.close.tray.note}" Foreground="{DynamicResource TextMuted}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
    </Button>
    <Button x:Name="ExitButton" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,12,0,0"
            AutomationProperties.Name="{DynamicResource s.close.exit}" AutomationProperties.HelpText="{DynamicResource s.close.exit.note}">
      <StackPanel>
        <TextBlock Text="{DynamicResource s.close.exit}" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource s.close.exit.note}" Foreground="{DynamicResource TextMuted}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
    </Button>
    <Button x:Name="CancelButton" Content="{DynamicResource s.close.cancel}" IsCancel="True" HorizontalAlignment="Right" MinWidth="104" Margin="0,20,0,0"/>
  </StackPanel>
</Window>
